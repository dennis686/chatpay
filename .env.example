PORT=3000
# Long random string. Needed to open /admin.html and export applications.
ADMIN_TOKEN=change-me-to-a-long-random-string
# PostgreSQL connection string, e.g. postgres://user:password@localhost:5432/chatpay
DATABASE_URL=
# Confirmation emails (Brevo). Leave blank to disable.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Chatpay
SUPPORT_EMAIL=
# Signs worker login cookies. Use a different long random string.
SESSION_SECRET=
